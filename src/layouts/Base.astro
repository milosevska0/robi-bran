---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, routes, business, type Lang, type PageKey, type Alt } from '../i18n/content';
import { data, phones, hoursSchema, products, productPath, findImage, L } from '../lib/site';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';

export type Crumb = { name: string; path: string };
interface Props { lang: Lang; page: PageKey; title: string; description: string; alt?: Alt; ogImage?: string; crumbs?: Crumb[]; }
const { lang, page } = Astro.props;
const title = Astro.props.title || t[lang].brand;
const description = Astro.props.description;
const alt: Alt = Astro.props.alt ?? (page === 'product' ? routes.products : routes[page]);
const site = Astro.site ?? new URL('https://pilanatetovo.mk');
const url = (p: string) => new URL(p, site).href;
const d = t[lang];
const k = data.kontakt;
// Picture shown when the page is shared (Facebook, Viber...) — the page's own main photo.
const ogMeta = findImage(Astro.props.ogImage ?? data.pocetna.glavnaSlika.slika);
const og = ogMeta ? url((await getImage({ src: ogMeta, width: Math.min(1200, ogMeta.width), format: 'jpg', quality: 80 })).src) : url('/og-image.jpg');
const homeOgMeta = findImage(data.pocetna.glavnaSlika.slika);
const homeOg = homeOgMeta ? url((await getImage({ src: homeOgMeta, width: Math.min(1200, homeOgMeta.width), format: 'jpg', quality: 80 })).src) : url('/og-image.jpg');
const crumbs = Astro.props.crumbs ?? [];
const notice = data.izvestuvanje.vkluceno ? L(data.izvestuvanje.tekst, lang) : '';

// Information for Google (LocalBusiness), so the pilana shows up properly in search and Maps.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': url('/#business'),
  name: t.mk.brand,
  alternateName: ['Pilana Tetovo', 'Pilana Robi Bran Tetovo', 'Pilana Robi Bran', 'Robi Bran', 'Pilana Robi-Bran', t.sq.brand, 'Sharra Tetovë'],
  description: L(data.pocetna.seo?.opis, 'mk'),
  url: url('/'),
  logo: url('/og-logo.png'),
  image: [homeOg, url('/og-image.jpg')],
  areaServed: [{ '@type': 'City', name: 'Тетово' }, { '@type': 'AdministrativeArea', name: 'Полог' }],
  knowsLanguage: ['mk', 'sq'],
  ...(phones.length ? { telephone: phones.map((p) => p.tel) } : {}),
  ...(k.email?.trim() ? { email: k.email.trim() } : {}),
  foundingDate: business.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: L(k.adresa, 'mk').split(',')[0],
    addressLocality: 'Туденце, Тетово',
    addressRegion: 'Тетово',
    postalCode: '1200',
    addressCountry: 'MK',
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng },
  hasMap: business.mapsLink,
  ...(hoursSchema.length ? { openingHoursSpecification: hoursSchema } : {}),
  ...(k.facebook?.trim() ? { sameAs: [k.facebook.trim()] } : {}),
  makesOffer: products.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Product', name: L(p.ime, 'mk'), description: L(p.kratokOpis, 'mk'), url: url(productPath(p, 'mk')) } })),
};
const website = page === 'home' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t[lang].brand,
  alternateName: ['Pilana Tetovo', 'Pilana Robi Bran'],
  url: url(routes.home[lang]),
  inLanguage: lang,
  publisher: { '@id': url('/#business') },
} : null;
const breadcrumbs = crumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: t[lang].breadcrumbHome, path: routes.home[lang] }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: url(c.path) })),
} : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(alt[lang])} />
    <link rel="alternate" hreflang="mk" href={url(alt.mk)} />
    <link rel="alternate" hreflang="sq" href={url(alt.sq)} />
    <link rel="alternate" hreflang="x-default" href={url(alt.mk)} />
    <meta name="theme-color" content="#1E4D33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(alt[lang])} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={lang === 'mk' ? 'mk_MK' : 'sq_MK'} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {website && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');</script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'mk' ? 'Прескокни до содржината' : 'Kalo te përmbajtja'}</a>
    {notice && <div class="notice" role="status" aria-label={d.notice}><div class="wrap">{notice}</div></div>}
    <Header lang={lang} page={page} alt={alt} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} alt={alt} />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Scroll reveals: text and cards rise in, photos open like a curtain.
      if (!reduce && 'IntersectionObserver' in window) {
        const groups: [string, string][] = [
          ['main h2, .section-head p, .prose p, .band p, .band .link, .band .btns, .values-grid > div, .faq-list > div, .card h2, .card h3, .card p, .card ul, .card .link, .steps li, .specs, .detail-text > p, .detail-text .btns, .info li, .contact-col > .btns, .contact-col > .link, .form, .others a, .filters, main > .wrap > p', 'reveal'],
          ['.card img, .mosaic img, .split img, .detail-photos img, .photo-grid img, .map', 'reveal-img'],
        ];
        const items: HTMLElement[] = [];
        for (const [sel, cls] of groups) {
          document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
            if (el.closest('.hero, .banner')) return;
            el.classList.add(cls);
            items.push(el);
          });
        }
        // Stagger: elements that appear together come in one after another.
        // Clipped photos can't be "seen" by the observer, so we watch their parent box instead.
        const targetOf = (el: HTMLElement) => (el.classList.contains('reveal-img') ? el.parentElement! : el);
        const io = new IntersectionObserver((entries) => {
          const shown = new Set(entries.filter((e) => e.isIntersecting).map((e) => e.target));
          const visible = items.filter((el) => !el.classList.contains('in') && shown.has(targetOf(el)));
          visible.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top || a.getBoundingClientRect().left - b.getBoundingClientRect().left);
          visible.forEach((el, i) => {
            el.style.setProperty('--d', `${Math.min(i * 0.09, 0.6)}s`);
            el.classList.add('in');
          });
          shown.forEach((t) => { if (items.every((el) => targetOf(el) !== t || el.classList.contains('in'))) io.unobserve(t); });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        new Set(items.map(targetOf)).forEach((t) => io.observe(t));
      }

      // 2) Parallax: background photos move slower than the page;
      //    the hero text fades and lifts away as you scroll down.
      const sections = [...document.querySelectorAll<HTMLElement>('.parallax')];
      const heroInner = document.querySelector<HTMLElement>('.hero-inner');
      let ticking = false;
      const update = () => {
        ticking = false;
        if (reduce) return;
        const vh = window.innerHeight;
        for (const s of sections) {
          const r = s.getBoundingClientRect();
          if (r.bottom < 0 || r.top > vh) continue;
          const img = s.querySelector<HTMLElement>('.cover');
          if (!img) continue;
          // -1 when the section enters at the bottom, 0 in the middle, 1 when it leaves at the top
          const p = (vh / 2 - (r.top + r.height / 2)) / (vh / 2 + r.height / 2);
          img.style.transform = `translate3d(0, ${(p * r.height * 0.25).toFixed(1)}px, 0)`;
        }
        if (heroInner) {
          const t = Math.min(Math.max(window.scrollY / (vh * 0.6), 0), 1);
          heroInner.style.opacity = String(1 - t);
          heroInner.style.translate = `0 ${(-t * 80).toFixed(1)}px`;
        }
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    </script>
  </body>
</html>
