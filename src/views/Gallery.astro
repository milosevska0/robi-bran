---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Pic from '../components/Pic.astro';
import { t, type Lang } from '../i18n/content';
import { data, responsive, L } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t[lang].galleryPage;
const g = data.galerija;
const items = await Promise.all(
  (g.sliki ?? []).filter((i) => i.slika).map(async (i) => ({ ...i, big: (await responsive(i.slika))?.src })),
);
const filters = (['all', 'grada', 'pelet', 'pilana'] as const).filter((f) => f === 'all' || items.some((i) => i.kategorija === f));
---
<Base lang={lang} page="gallery" title={L(g.seo?.naslov, lang)} description={L(g.seo?.opis, lang)}>
  <Banner lang={lang} title={L(g.naslov, lang)} photo={g.slika} />
  <section class="wrap section">
    {filters.length > 2 && (
      <div class="filters" role="group" aria-label={ui.filterLabel}>
        {filters.map((f) => (
          <button class="filter" type="button" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'}>{ui.filters[f]}</button>
        ))}
      </div>
    )}
    <div class="photo-grid">
      {items.filter((i) => i.big).map((item) => (
        <a href={item.big} data-cat={item.kategorija} target="_blank" rel="noopener">
          <Pic src={item.slika} alt={L(item.opis, lang)} sizes="(max-width: 700px) 50vw, 33vw" />
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.photo-grid [data-cat]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((i) => (i.hidden = f !== 'all' && i.dataset.cat !== f));
    }),
  );
</script>
