---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Pic from '../components/Pic.astro';
import Values from '../components/Values.astro';
import CtaBand from '../components/CtaBand.astro';
import { type Lang } from '../i18n/content';
import { data, L } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const a = data.zaNas;
const paras = (list: { mk: string; sq: string }[] | undefined) => (list ?? []).map((p) => L(p, lang)).filter(Boolean);
---
<Base lang={lang} page="about" title={L(a.seo?.naslov, lang)} description={L(a.seo?.opis, lang)}>
  <Banner lang={lang} title={L(a.naslov, lang)} photo={a.slika} />

  <section class="wrap section split">
    <div class="prose">
      <h2>{L(a.prikazna.naslov, lang)}</h2>
      {paras(a.prikazna.paragrafi).map((p) => <p>{p}</p>)}
    </div>
    <Pic src={a.prikazna.slika.slika} alt={L(a.prikazna.slika.opis, lang)} />
  </section>

  <Values lang={lang} />

  <section class="wrap section split reverse-sm">
    <Pic src={a.rabota.slika.slika} alt={L(a.rabota.slika.opis, lang)} />
    <div class="prose">
      <h2 class="ink">{L(a.rabota.naslov, lang)}</h2>
      {paras(a.rabota.paragrafi).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <CtaBand lang={lang} title={L(a.povik.naslov, lang)} text={L(a.povik.tekst, lang)} />
</Base>
