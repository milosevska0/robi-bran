---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import ContactInfo from '../components/ContactInfo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import ContactForm from '../components/ContactForm.astro';
import { t, routes, business, type Lang } from '../i18n/content';
import { data, L } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t[lang];
const c = data.kontaktStrana;
const fb = data.kontakt.facebook?.trim();
---
<Base lang={lang} page="contact" title={L(c.seo?.naslov, lang)} description={L(c.seo?.opis, lang)} ogImage={c.slika} crumbs={[{ name: L(c.naslov, lang), path: routes.contact[lang] }]}>
  <Banner lang={lang} title={L(c.naslov, lang)} photo={c.slika} />
  <section class="wrap section contact-page">
    <div class="contact-col">
      <h2 class="green">{L(data.pocetna.kontakt.naslov, lang)}</h2>
      <ContactInfo lang={lang} />
      {fb && <a class="link" href={fb} target="_blank" rel="noopener">{d.followFb}</a>}
      <div style="height: 360px;"><MapEmbed lang={lang} /></div>
      <a class="btn btn-green" style="align-self: flex-start;" href={business.mapsLink} target="_blank" rel="noopener">{d.openMaps}</a>
    </div>
    <ContactForm lang={lang} title={L(c.formular.naslov, lang)} text={L(c.formular.tekst, lang)} />
  </section>
</Base>

<style>
  .contact-page { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 56px 80px; align-items: start; }
  .contact-page h2 { font-size: 36px; }
  .contact-page :global(.map) { min-height: 0; height: 100%; }
  @media (max-width: 700px) {
    .contact-page { grid-template-columns: 1fr; gap: 40px; padding-bottom: 0; }
    .contact-page h2 { font-size: 26px; }
    .contact-page > .contact-col > div { height: 240px !important; }
    .contact-page > .contact-col > .btn { align-self: stretch !important; }
  }
</style>
