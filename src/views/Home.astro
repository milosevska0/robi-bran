---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Values from '../components/Values.astro';
import ContactInfo from '../components/ContactInfo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Faq from '../components/Faq.astro';
import { t, routes, business, type Lang } from '../i18n/content';
import { data, mainPhone, products, productPath, L } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t[lang];
const h = data.pocetna;
const fb = data.kontakt.facebook?.trim();
const mosaic = h.galerija.sliki ?? [];
const mosaicClass = ['big', 'hide-sm', '', '', 'hide-sm'];
---
<Base lang={lang} page="home" title={L(h.seo?.naslov, lang)} description={L(h.seo?.opis, lang)}>
  <section class="hero parallax">
    <Pic src={h.glavnaSlika.slika} class="cover" sizes="100vw" eager alt={L(h.glavnaSlika.opis, lang)} />
    <div class="shade"></div>
    <div class="wrap hero-inner">
      <h1>{d.brand}</h1>
      <p>{L(h.heroTekst, lang)}</p>
      <div class={`btns ${mainPhone ? 'btns-2' : ''}`}>
        {mainPhone && <a class="btn btn-white" href={`tel:${mainPhone.tel}`}><Icon name="phone" />{d.call}</a>}
        <a class="btn btn-ghost" href={routes.products[lang]}><span class="only-lg">{d.home.seeProducts}</span><span class="only-sm">{d.nav.products}</span></a>
      </div>
    </div>
  </section>

  <section class="band story parallax">
    <Pic src={h.prikazna.slika} class="cover" sizes="100vw" />
    <div class="shade-strong"></div>
    <div class="narrow band-inner">
      <h2>{L(h.prikazna.naslov, lang)}</h2>
      <p>{L(h.prikazna.tekst, lang)}</p>
      <a class="link" href={routes.about[lang]}>{d.home.readAbout}</a>
    </div>
  </section>

  <Values lang={lang} />

  {products.length > 0 && (
    <section class="wrap section">
      <div class="section-head">
        <h2>{L(h.proizvodi.naslov, lang)}</h2>
        <p>{L(h.proizvodi.tekst, lang)}</p>
      </div>
      <div class="cards">
        {products.map((p) => (
          <article class="card">
            <Pic src={p.sliki?.[0]?.slika} alt={L(p.sliki?.[0]?.opis, lang)} />
            <h3>{L(p.ime, lang)}</h3>
            <p class="grow">{L(p.kratokOpis, lang)}</p>
            <a class="link" href={productPath(p, lang)}>{d.more}</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="border-top">
    <div class="wrap section">
      <div class="section-head">
        <h2>{L(h.galerija.naslov, lang)}</h2>
        <a class="link" href={routes.gallery[lang]}>{d.home.galleryAll}</a>
      </div>
      <div class="mosaic">
        {mosaic.slice(0, 5).map((m, i) => (
          <Pic src={m.slika} alt={L(m.opis, lang)} class={mosaicClass[i] || undefined} sizes={i === 0 ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, 25vw'} />
        ))}
      </div>
    </div>
  </section>

  <Faq lang={lang} />

  <section class="band parallax">
    <Pic src={h.kontakt.slika} class="cover" sizes="100vw" />
    <div class="shade-strong"></div>
    <div class="wrap band-inner contact-grid">
      <div class="contact-col">
        <h2>{L(h.kontakt.naslov, lang)}</h2>
        <ContactInfo lang={lang} dark />
        <div class="btns btns-2">
          <a class="btn btn-white" href={business.mapsLink} target="_blank" rel="noopener"><span class="only-lg">{d.openMaps}</span><span class="only-sm">{d.openMapsShort}</span></a>
          <a class="btn btn-ghost" href={routes.contact[lang]}>{d.contactUs}</a>
        </div>
        {fb && <a class="link" href={fb} target="_blank" rel="noopener">{d.followFb}</a>}
      </div>
      <MapEmbed lang={lang} />
    </div>
  </section>
</Base>
