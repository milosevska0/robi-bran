---
// One product page. Pages are made automatically for every product in the admin panel.
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import { t, routes, type Lang } from '../i18n/content';
import { products, productPath, productAlt, mainPhone, L, type Product } from '../lib/site';
interface Props { lang: Lang; product: Product; }
const { lang, product } = Astro.props;
const d = t[lang];
const name = L(product.ime, lang);
const [main, ...thumbs] = (product.sliki ?? []).filter((s) => s.slika);
const specs = (product.detali ?? []).map((r) => [L(r.naslov, lang), L(r.vrednost, lang)]).filter(([k, v]) => k || v);
const others = products.filter((p) => p !== product);
---
<Base lang={lang} page="product" title={L(product.seo?.naslov, lang) || name} description={L(product.seo?.opis, lang) || L(product.kratokOpis, lang)} alt={productAlt(product)}>
  <div class="wrap">
    <div class="crumbs-dark"><a href={routes.home[lang]}>{d.breadcrumbHome}</a> / <a href={routes.products[lang]}>{d.nav.products}</a> / {name}</div>
    <section class="detail">
      <div class="detail-photos">
        {main && <Pic src={main.slika} eager alt={L(main.opis, lang)} />}
        {thumbs.length > 0 && (
          <div class="thumbs">
            {thumbs.slice(0, 3).map((p) => <Pic src={p.slika} alt={L(p.opis, lang)} sizes="(max-width: 700px) 33vw, 200px" />)}
          </div>
        )}
      </div>
      <div class="detail-text">
        <h1>{name}</h1>
        <p>{L(product.tekstNaStrana, lang)}</p>
        {specs.length > 0 && (
          <dl class="specs">
            {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        )}
        <div class={`btns ${mainPhone ? 'btns-2' : ''}`}>
          {mainPhone && <a class="btn btn-green" href={`tel:${mainPhone.tel}`}><Icon name="phone" /><span class="only-lg">{d.callForPrice}</span><span class="only-sm">{d.call}</span></a>}
          <a class="btn btn-outline" href={routes.contact[lang]}>{d.writeUs}</a>
        </div>
      </div>
    </section>
  </div>

  {others.length > 0 && (
    <section class="stone">
      <div class="wrap section">
        <h2 style="font-size: 32px; margin-bottom: 28px;">{d.otherProducts}</h2>
        <div class="others">
          {others.map((o) => (
            <a class="other" href={productPath(o, lang)}>
              <Pic src={o.sliki?.[0]?.slika} sizes="200px" />
              <div style="padding-right: 20px;"><strong>{L(o.ime, lang)}</strong><span>{L(o.kratokOpis, lang)}</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
