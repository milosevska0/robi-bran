---
import { t, routes, type Lang, type Alt } from '../i18n/content';
interface Props { lang: Lang; alt: Alt; }
const { lang, alt } = Astro.props;
const d = t[lang];
const keys = ['about', 'products', 'gallery', 'contact'] as const;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-row">
      <img src="/robibran-logo.svg" alt={d.brand} width="295" height="76" loading="lazy" />
      <nav class="footer-nav" aria-label={d.footerMenu}>
        {keys.map((k) => <a href={routes[k][lang]}>{d.nav[k]}</a>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <div>© {new Date().getFullYear()} {d.brand}. {d.rights}<br /><span class="latin-line">{d.latinLine}</span></div>
      <div><a href={alt.mk} lang="mk">Македонски</a> / <a href={alt.sq} lang="sq">Shqip</a></div>
    </div>
  </div>
</footer>
