---
// A photo from /public/images with a small and a large version.
import { photos, type PhotoKey, type Lang } from '../i18n/content';
interface Props { photo: PhotoKey; lang: Lang; class?: string; sizes?: string; eager?: boolean; decorative?: boolean; alt?: string; }
const { photo, lang, class: cls, sizes = '(max-width: 700px) 100vw, 50vw', eager = false, decorative = false, alt } = Astro.props;
const p = photos[photo];
const base = `/images/${p.src}`;
---
<img
  src={`${base}-1600.webp`}
  srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`}
  sizes={sizes}
  alt={decorative ? '' : (alt ?? p[lang])}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
