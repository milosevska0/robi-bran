---
// A photo uploaded through the admin panel (src/assets/uploads), with a small and a large version.
import { responsive } from '../lib/site';
interface Props { src: string | undefined; alt?: string; class?: string; sizes?: string; eager?: boolean; }
const { src, alt = '', class: cls, sizes = '(max-width: 700px) 100vw, 50vw', eager = false } = Astro.props;
const img = await responsive(src);
---
{img && (
  <img
    src={img.src}
    srcset={img.srcset}
    sizes={sizes}
    alt={alt}
    title={alt || undefined}
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
)}
