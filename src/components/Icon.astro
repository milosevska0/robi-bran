---
// Thin line icons. Only phone, pin, clock, mail and the menu icons are used (approved).
interface Props { name: 'phone' | 'pin' | 'clock' | 'mail' | 'menu' | 'close'; size?: number; color?: string; }
const { name, size = 20, color = 'currentColor' } = Astro.props;
---
<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke={color} stroke-width={name === 'menu' || name === 'close' ? 1.8 : 1.7} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
</svg>
