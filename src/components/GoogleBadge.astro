---
// Small Google rating badge, fixed bottom-left. Hidden when no rating is set in the admin panel.
import { type Lang } from '../i18n/content';
import { data } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = (data.kontakt as any).google ?? {};
const rating = String(g.ocena ?? '').trim().replace(',', '.');
const n = parseFloat(rating);
const label = lang === 'sq' ? 'Vlerësimi në Google' : 'Google оцена';
---
{rating && !isNaN(n) && (
  <a class="gbadge" href={g.link || undefined} target="_blank" rel="noopener" aria-label={`${label} ${rating} / 5`}>
    <svg class="g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.3l7.9 6.1C12.5 13.6 17.8 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.6 5.9c4.4-4.1 6.7-10.1 6.7-17.3z"/><path fill="#FBBC05" d="M10.5 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.1C1 16.6 0 20.2 0 24s1 7.4 2.7 10.7l7.8-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.2 0-11.5-4.1-13.4-9.8l-7.9 6.1C6.6 42.6 14.6 48 24 48z"/></svg>
    <span class="t">
      <strong>{label}</strong>
      <span class="r"><b>{rating}</b><span class="stars" style={`--p:${Math.min(n, 5) / 5 * 100}%`}>★★★★★</span></span>
    </span>
  </a>
)}
<style>
  .gbadge { position: fixed; left: 16px; bottom: 16px; z-index: 50; display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #fff; border-radius: 10px; box-shadow: 0 4px 18px rgba(0,0,0,.18); color: #222; text-decoration: none; font-family: system-ui, sans-serif; line-height: 1.2; }
  .g { width: 28px; height: 28px; flex: none; }
  .t { display: flex; flex-direction: column; gap: 2px; }
  .t strong { font-size: 14px; font-weight: 600; }
  .r { display: flex; align-items: center; gap: 6px; }
  .r b { color: #E7711B; font-size: 15px; }
  .stars { font-size: 16px; letter-spacing: 1px; background: linear-gradient(90deg, #F4A21B var(--p), #ddd var(--p)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (max-width: 700px) { .gbadge { left: 10px; bottom: 10px; padding: 7px 10px; gap: 8px; } .g { width: 22px; height: 22px; } .t strong { font-size: 12px; } .stars { font-size: 13px; } }
  @media print { .gbadge { display: none; } }
</style>
