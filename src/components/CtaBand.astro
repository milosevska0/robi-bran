---
// Dark green band over a photo with a title, a sentence and two buttons.
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { t, routes, type Lang } from '../i18n/content';
import { data, mainPhone } from '../lib/site';
interface Props { lang: Lang; title: string; text: string; }
const { lang, title, text } = Astro.props;
const d = t[lang];
---
<section class="band cta parallax">
  <Pic src={data.pocetna.kontakt.slika} class="cover" sizes="100vw" />
  <div class="shade-strong"></div>
  <div class="narrow band-inner">
    <h2>{title}</h2>
    {text && <p>{text}</p>}
    <div class={`btns ${mainPhone ? 'btns-2' : ''}`}>
      {mainPhone && <a class="btn btn-white" href={`tel:${mainPhone.tel}`}><Icon name="phone" />{d.call}</a>}
      <a class="btn btn-ghost" href={routes.contact[lang]}>{d.contactUs}</a>
    </div>
  </div>
</section>
