---
// One page per product from the admin panel (src/data/proizvodi.json).
import V from '../../../views/ProductDetail.astro';
import { products } from '../../../lib/site';
export function getStaticPaths() {
  return products.filter((p) => p.adresa?.sq).map((p) => ({ params: { slug: p.adresa.sq }, props: { product: p } }));
}
---
<V lang="sq" product={Astro.props.product} />
